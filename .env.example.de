# Kopieren nach .env und anpassen - oder einfach:  websearch init --contact du@eure-firma.de
# docker compose liest die Datei selbst; lokal laden mit:  set -a; . ./.env; set +a
# Werte: $VAR / ${VAR} werden in unquotierten und "doppelt" quotierten Werten ersetzt (wie compose und die Shell) -
# Passwörter oder Tokens mit $ in 'einfache Anführungszeichen' setzen.
# Englische Fassung dieser Datei: .env.example
SEARXNG_SECRET=
# SearXNG-Image-Tag (Standard: die getestete Version; neuere Tags: hub.docker.com/r/searxng/searxng/tags, oder "latest")
# SEARXNG_VERSION=2026.11.5-3e95f6cd2
# nur Podman-Quadlet: Host-Port von SearXNG (Standard 8888)
# SEARXNG_PORT=8888
# Wikimedia/GDELT verlangen einen Kontakt im User-Agent
WEBSEARCH_UA="websearch/0.3.0 (kontakt@eure-firma.example)"
# Sprache von Kommandozeile, Logs und Benachrichtigungen: de | en (Standard: Systemsprache)
WEBSEARCH_LANG=de
# Eigener kostenloser Marginalia-Key: Mail an contact@marginalia-search.com
MARGINALIA_KEY=public
# Quellen abschalten, kommagetrennt (z.B. bing_rss bei kommerzieller Nutzung)
WEBSEARCH_DISABLE=
# Log-Level: DEBUG, INFO, WARNING (Standard), ERROR
WEBSEARCH_LOG_LEVEL=

# --- Pfade und Dienste: Docker setzt diese selbst - nur für lokale Läufe einkommentieren -------------
# SearXNG-Instanz (Docker: http://searxng:8080, lokal: http://127.0.0.1:8888)
# SEARXNG_URL=http://127.0.0.1:8888
# SQLite-Dateien: Cache + hostweite Pausen/Tempo/Bezahl-Zähler/Metriken bzw. Monitoring-Zustand
# (alle Prozesse eines Hosts sollten dieselbe Cache-Datei nutzen)
# WEBSEARCH_CACHE=
# WEBSEARCH_MONITOR_DB=
# MCP-Server über HTTP: Bind-Adresse, Port, erlaubte Host-Header (DNS-Rebinding-Schutz)
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*

# --- MCP-Server über HTTP: Zugriffsschutz ---------------------------------------------------------
# Gesetzt -> jede Anfrage an /mcp und /metrics braucht "Authorization: Bearer <token>" (/healthz bleibt offen).
# Pflicht, sobald der Port über 127.0.0.1 hinaus erreichbar ist. Erzeugen:
#   sed -i "s/^MCP_AUTH_TOKEN=.*/MCP_AUTH_TOKEN=$(openssl rand -hex 32)/" .env
MCP_AUTH_TOKEN=
# Fernzugriff zusätzlich: öffentlichen Hostnamen erlauben (DNS-Rebinding-Schutz bleibt aktiv), mit und ohne Port
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,suche.example.org,suche.example.org:*
# 1 = im Container ohne Token auf 0.0.0.0 lauschen erlauben (Standard 0: ohne MCP_AUTH_TOKEN startet der
#     MCP-Server im Container nicht). Nur, wenn der Port auf 127.0.0.1 eines Einzelplatzrechners veröffentlicht
#     ist; ein öffentlicher Name in MCP_ALLOWED_HOSTS braucht immer ein Token
# MCP_ALLOW_NO_AUTH=
# Container-Erkennung erzwingen (1/0); sonst /.dockerenv (Docker) bzw. /run/.containerenv (Podman)
# WEBSEARCH_IN_CONTAINER=
# 0 = MCP-Agents dürfen Bezahl-APIs nie nutzen
WEBSEARCH_MCP_PAID=1

# --- Docker-Image ---------------------------------------------------------------------------------
# Fertiges Image statt lokalem Build (docker compose pull && docker compose up -d --no-build)
# WEBSEARCH_IMAGE=ghcr.io/c0decave/multi-websearch-mcp:0.3.0rc2

# --- Proxys (optional, siehe ANALYSE.md Abschnitt 3.1) --------------------------------------------
# für die eigenen öffentlichen HTTP-Quellen (Bing-RSS, Google News, GDELT, HN, Wikipedia, Marginalia) und
# fetch_url - nie für die eigene SearXNG-Instanz, die Bezahl-APIs und Reddit (Keys/Zugangsdaten nicht über Proxys)
# WEBSEARCH_PROXY=
# für die ddgs-Quellen (wertet ddgs selbst aus); SearXNG: outgoing.proxies in searxng/settings.yml
# DDGS_PROXY=

# --- Reddit (offizielle API, kostenlos für "script"-Apps, ~100 Anfragen/min) ---------------------
# App anlegen unter https://www.reddit.com/prefs/apps (Typ "script"); Quelle ist nur mit beiden Werten aktiv
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# optional: Reddit wünscht "<plattform>:<app-id>:<version> (by /u/<name>)" (Standard: WEBSEARCH_UA)
# REDDIT_USER_AGENT=

# --- Optionale Bezahl-/Freikontingent-APIs: nur letzte Reserve -----------------------------------
# Reihenfolge: exa -> linkup -> tavily -> brave_api -> perplexity -> serper; genutzt wird, bis EINE liefert.
# Bezahlquellen werden immer mit max. 10 Treffern gefragt (weitere Treffer kosten bei manchen extra).
# Exa: 10 $ Freiguthaben/Monat, ohne Zahlungsmittel; Modus "fast" (Lite-Tarif) ist Standard
EXA_API_KEY=
EXA_SEARCH_TYPE=fast
# Linkup: monatliches Gratiskontingent, danach ca. 5 $/1.000
LINKUP_API_KEY=
# Tavily: 1.000 Credits/Monat gratis, ohne Karte
TAVILY_API_KEY=
# Brave: 5 $ Freiguthaben/Monat (~1.000 Anfragen), Kreditkarte nötig
BRAVE_API_KEY=
# Perplexity Search API: Modus "fast" = 1 $/1.000 (Standard), "pro" = Standardmodus 5 $/1.000
PERPLEXITY_API_KEY=
PERPLEXITY_SEARCH_TYPE=fast
# Serper (Google-Ergebnisse): 2.500 gratis, danach Prepaid ab ~1 $/1.000
SERPER_API_KEY=
# Harte Kostengrenze: max. Bezahl-Abfragen pro Tag / Monat (UTC, hostweit gezählt, siehe "websearch status").
# Zusätzlich im Dashboard des Anbieters ein Ausgabelimit setzen (Brave bucht nach dem Freiguthaben
# ohne Warnung per Kreditkarte weiter).
WEBSEARCH_PAID_DAILY_LIMIT=100
WEBSEARCH_PAID_MONTHLY_LIMIT=1000

# --- fetch_url (Seitenabruf für Agents) ----------------------------------------------------------
# 1 = auch Ziele im internen Netz erlauben (nur für Intranet-Nutzung!)
WEBSEARCH_FETCH_ALLOW_PRIVATE=0
# 1 = robots.txt ignorieren (nicht empfohlen)
WEBSEARCH_FETCH_IGNORE_ROBOTS=0
# 0 = Google-News-Weiterleitungen nicht auflösen (fetch_url lehnt sie dann mit Hinweis ab)
# WEBSEARCH_GNEWS_DECODE=1

# --- Monitoring ------------------------------------------------------------------------------------
# Ziel für neue Treffer und Blind-Warnungen: selbst gehostetes ntfy, n8n, Slack, Discord, Teams, Telegram ...
WEBSEARCH_WEBHOOK=
# json (Standard) | text (ntfy) | slack | discord | teams (Workflows-Webhook) | telegram | email
WEBSEARCH_WEBHOOK_FORMAT=json
# nur telegram: Chat-ID (Zahl, Gruppen negativ) oder @kanalname; WEBSEARCH_WEBHOOK = https://api.telegram.org/bot<TOKEN>/sendMessage
# WEBSEARCH_TELEGRAM_CHAT_ID=
# nur email (WEBSEARCH_WEBHOOK wird dann nicht gebraucht): SMTP-Server
# WEBSEARCH_SMTP_HOST=
# Port (Standard 587, bei WEBSEARCH_SMTP_TLS=ssl 465)
# WEBSEARCH_SMTP_PORT=587
# starttls (Standard) | ssl | none
# WEBSEARCH_SMTP_TLS=starttls
# Login (optional, nur zusammen mit dem Passwort)
# WEBSEARCH_SMTP_USER=
# WEBSEARCH_SMTP_PASSWORD=
# Absender (Standard: WEBSEARCH_SMTP_USER, falls das eine Adresse ist)
# WEBSEARCH_SMTP_FROM=
# Empfänger, kommagetrennt
# WEBSEARCH_SMTP_TO=
# nach so vielen "blinden" Läufen in Folge (0 Treffer wegen Fehlern) eine Warnung senden
WEBSEARCH_BLIND_AFTER=3
# so viele Watches laufen höchstens gleichzeitig (verteilt die Last auf die Suchmaschinen)
WEBSEARCH_MONITOR_CONCURRENCY=2
# optional: jede Meldung (Treffer und Blind-/Recovered-Warnungen) zusätzlich als JSON-Zeile in diese Datei
# WEBSEARCH_MONITOR_OUT=
# optional: Datei, die nach jedem Monitor-Durchlauf aktualisiert wird (Docker-Healthcheck)
# WEBSEARCH_HEARTBEAT=

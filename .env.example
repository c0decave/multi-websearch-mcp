# Copy to .env and adjust - or simply run:  websearch init --contact you@your-company.com
# docker compose reads this file itself; for local runs load it with:  set -a; . ./.env; set +a
# Values: $VAR / ${VAR} are expanded in unquoted and "double-quoted" values (like compose and the shell) -
# put passwords or tokens containing $ in 'single quotes'.
# German version of this file: .env.example.de
SEARXNG_SECRET=
# SearXNG image tag (default: the tested version; newer tags: hub.docker.com/r/searxng/searxng/tags, or "latest")
# SEARXNG_VERSION=2026.11.5-3e95f6cd2
# Podman Quadlet only: host port of SearXNG (default 8888)
# SEARXNG_PORT=8888
# Wikimedia/GDELT require a contact in the User-Agent
WEBSEARCH_UA="websearch/0.3.0 (contact@your-company.example)"
# Language of CLI output, logs and notifications: de | en (default: system language)
WEBSEARCH_LANG=en
# Own free Marginalia key: mail to contact@marginalia-search.com
MARGINALIA_KEY=public
# Disable sources, comma-separated (e.g. bing_rss for commercial use)
WEBSEARCH_DISABLE=
# Log level: DEBUG, INFO, WARNING (default), ERROR
WEBSEARCH_LOG_LEVEL=

# --- Paths and services: Docker sets these itself - uncomment only for local runs ----------------
# SearXNG instance (Docker: http://searxng:8080, local: http://127.0.0.1:8888)
# SEARXNG_URL=http://127.0.0.1:8888
# SQLite files: cache + host-wide pauses/rate slots/paid counters/metrics, and monitoring state
# (all processes of a host should share the same cache file)
# WEBSEARCH_CACHE=
# WEBSEARCH_MONITOR_DB=
# MCP server over HTTP: bind address, port, allowed Host headers (DNS rebinding protection)
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*

# --- MCP server over HTTP: access protection -------------------------------------------------------
# If set, every request to /mcp and /metrics needs "Authorization: Bearer <token>" (/healthz stays open).
# Required as soon as the port is reachable beyond 127.0.0.1. Generate:
#   sed -i "s/^MCP_AUTH_TOKEN=.*/MCP_AUTH_TOKEN=$(openssl rand -hex 32)/" .env
MCP_AUTH_TOKEN=
# Remote access additionally: allow the public host name (DNS rebinding protection stays on), with and without port
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,search.example.org,search.example.org:*
# 1 = allow listening on 0.0.0.0 without a token inside a container (default 0: without MCP_AUTH_TOKEN the
#     containerized MCP server does not start). Only if the port is published on 127.0.0.1 on a single-user
#     machine; a public name in MCP_ALLOWED_HOSTS always needs a token
# MCP_ALLOW_NO_AUTH=
# force container detection (1/0); otherwise /.dockerenv (Docker) or /run/.containerenv (Podman)
# WEBSEARCH_IN_CONTAINER=
# 0 = MCP agents may never use paid APIs
WEBSEARCH_MCP_PAID=1

# --- Docker image -----------------------------------------------------------------------------------
# Prebuilt image instead of a local build (docker compose pull && docker compose up -d --no-build)
# WEBSEARCH_IMAGE=ghcr.io/c0decave/multi-websearch-mcp:0.3.0rc2

# --- Proxies (optional, see ANALYSE.md section 3.1) -------------------------------------------------
# for the own public HTTP sources (Bing RSS, Google News, GDELT, HN, Wikipedia, Marginalia) and fetch_url -
# never for your SearXNG instance, the paid APIs and Reddit (keys/credentials do not go through a proxy)
# WEBSEARCH_PROXY=
# for the ddgs sources (evaluated by ddgs itself); SearXNG: outgoing.proxies in searxng/settings.yml
# DDGS_PROXY=

# --- Reddit (official API, free for "script" apps, ~100 requests/min) ------------------------------
# Create an app at https://www.reddit.com/prefs/apps (type "script"); the source is active only with both values
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# optional: Reddit asks for "<platform>:<app-id>:<version> (by /u/<name>)" (default: WEBSEARCH_UA)
# REDDIT_USER_AGENT=

# --- Optional paid/free-tier APIs: last resort only ------------------------------------------------
# Order: exa -> linkup -> tavily -> brave_api -> perplexity -> serper; used until ONE answers.
# Paid sources are always asked for at most 10 results (more results cost extra with some).
# Exa: 10 $ free credit/month, no payment method; mode "fast" (Lite tier) is the default
EXA_API_KEY=
EXA_SEARCH_TYPE=fast
# Linkup: monthly free quota, then about 5 $/1,000
LINKUP_API_KEY=
# Tavily: 1,000 credits/month free, no card
TAVILY_API_KEY=
# Brave: 5 $ free credit/month (~1,000 queries), credit card required
BRAVE_API_KEY=
# Perplexity Search API: mode "fast" = 1 $/1,000 (default), "pro" = standard mode 5 $/1,000
PERPLEXITY_API_KEY=
PERPLEXITY_SEARCH_TYPE=fast
# Serper (Google results): 2,500 free, then prepaid from ~1 $/1,000
SERPER_API_KEY=
# Hard cost limit: max. paid queries per day / month (UTC, counted host-wide, see "websearch status").
# Also set a spending limit in the provider's dashboard (Brave keeps billing the credit card after the
# free credit without warning).
WEBSEARCH_PAID_DAILY_LIMIT=100
WEBSEARCH_PAID_MONTHLY_LIMIT=1000

# --- fetch_url (page retrieval for agents) ---------------------------------------------------------
# 1 = also allow targets in the internal network (intranet use only!)
WEBSEARCH_FETCH_ALLOW_PRIVATE=0
# 1 = ignore robots.txt (not recommended)
WEBSEARCH_FETCH_IGNORE_ROBOTS=0
# 0 = do not resolve Google News redirect links (fetch_url then refuses them with a hint)
# WEBSEARCH_GNEWS_DECODE=1

# --- Monitoring ------------------------------------------------------------------------------------
# Target for new results and blind warnings: self-hosted ntfy, n8n, Slack, Discord, Teams, Telegram ...
WEBSEARCH_WEBHOOK=
# json (default) | text (ntfy) | slack | discord | teams (Workflows webhook) | telegram | email
WEBSEARCH_WEBHOOK_FORMAT=json
# telegram only: chat id (number, groups negative) or @channelname; WEBSEARCH_WEBHOOK = https://api.telegram.org/bot<TOKEN>/sendMessage
# WEBSEARCH_TELEGRAM_CHAT_ID=
# email only (WEBSEARCH_WEBHOOK is not needed then): SMTP server
# WEBSEARCH_SMTP_HOST=
# port (default 587, 465 with WEBSEARCH_SMTP_TLS=ssl)
# WEBSEARCH_SMTP_PORT=587
# starttls (default) | ssl | none
# WEBSEARCH_SMTP_TLS=starttls
# login (optional, only together with the password)
# WEBSEARCH_SMTP_USER=
# WEBSEARCH_SMTP_PASSWORD=
# sender (default: WEBSEARCH_SMTP_USER if that is an address)
# WEBSEARCH_SMTP_FROM=
# recipients, comma-separated
# WEBSEARCH_SMTP_TO=
# send a warning after this many "blind" runs in a row (0 results because of errors)
WEBSEARCH_BLIND_AFTER=3
# at most this many watches run at the same time (spreads the load over the search engines)
WEBSEARCH_MONITOR_CONCURRENCY=2
# optional: additionally append every alert (results and blind/recovered warnings) as a JSON line to this file
# WEBSEARCH_MONITOR_OUT=
# optional: file updated after each monitor pass (Docker healthcheck)
# WEBSEARCH_HEARTBEAT=
